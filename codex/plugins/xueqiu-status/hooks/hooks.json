{
  "description": "Snowball: local status, session names and posted question titles; no answers or execution commands.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex_hook.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex_hook.py\" hook",
